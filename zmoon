#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# zmoon — ZeroTier Moon control CLI for Synology DS918+
#
# A single entry point for installing, updating, monitoring, and diagnosing
# the dual-NIC ZeroTier moon node.
#
#   zmoon install                 First-time setup (delegates to install.sh)
#   zmoon update [opts]           Rebuild + restart    (delegates to update.sh)
#   zmoon status                  Concise health summary
#   zmoon doctor                  Full automated diagnostics (PASS/WARN/FAIL)
#   zmoon peers                   Parsed peer list (role, latency, path)
#   zmoon moon-id                 Print Moon ID + client orbit command
#   zmoon connect                 Full join instructions for this moon (populated)
#   zmoon backup                  Back up moon identity (keeps last 5)
#   zmoon restore <dir>           Restore moon identity from a backup
#   zmoon logs [-f]               Show container logs
#   zmoon web [--host H --port P] Serve the web console + update API
#   zmoon boot                    Re-apply host tuning + watchdog (cron/Boot-up task)
#   zmoon install-cron [sched]    Auto re-apply tuning via DSM cron (default */15)
#   zmoon uninstall-cron          Remove the zmoon cron entry
#   zmoon autoupdate              Auto-update if AUTO_UPDATE=true in .env
#   zmoon version                 Print zmoon + ZeroTier versions
#   zmoon help                    Show this help
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# DSM is not standard Linux: cron and Task Scheduler invoke scripts with a
# minimal PATH that omits /usr/local/bin, /sbin, and the Container Manager dir.
# Without this, boot/autoupdate would call docker/sysctl/ethtool by bare name,
# fail to find them, and (being guarded with `|| true`) silently do nothing.
# Prepend the standard DSM binary locations so those commands always resolve.
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/syno/bin:/usr/syno/sbin:/var/packages/ContainerManager/target/usr/bin:${PATH:-}"

ZMOON_VERSION="1.0.0"
# Resolve the symlink first: /usr/local/bin/zmoon → <repo>/zmoon. Without this,
# SCRIPT_DIR points at /usr/local/bin, so .env and lib/ are never found when
# invoked via the symlink — which is exactly how the PATH command and the
# 15-min cron invoke it.
SELF="${BASH_SOURCE[0]}"
SELF="$(readlink -f "$SELF" 2>/dev/null || echo "$SELF")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"

# ─── Colours / output helpers ────────────────────────────────────────────────
if [[ -t 1 ]]; then
    R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m' B='\033[0;34m'
    DIM='\033[2m' BOLD='\033[1m' NC='\033[0m'
else
    R='' G='' Y='' B='' DIM='' BOLD='' NC=''
fi
say()  { echo -e "$*"; }
hdr()  { echo -e "\n${B}${BOLD}$*${NC}"; }
ok()   { echo -e "  ${G}✓${NC} $*"; }
warn() { echo -e "  ${Y}!${NC} $*"; }
err()  { echo -e "  ${R}✗${NC} $*" >&2; }
die()  { echo -e "${R}✗${NC} $*" >&2; exit 1; }

# ─── Lazy config load ────────────────────────────────────────────────────────
# Only commands that touch the deployment need .env / docker. help/version
# must work in any checkout (and in CI) with neither present.
CONTAINER_NAME="zerotier-moon"
DATA_DIR="/volume1/docker/zerotier"

load_env() {
    [[ -f "$ENV_FILE" ]] || die ".env not found — run 'zmoon install' first"
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    CONTAINER_NAME="${CONTAINER_NAME:-zerotier-moon}"
    DATA_DIR="${DATA_DIR:-/volume1/docker/zerotier}"
}

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker not found (install Container Manager)"
}

container_running() {
    [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || echo false)" == "true" ]]
}

zt() { docker exec "$CONTAINER_NAME" zerotier-cli "$@" 2>/dev/null; }

# Print the raw basename (without .moon) of the first moon file found — this is
# the 16-char zero-padded world ID, e.g. 0000001be423ea4f.
# Uses a bash glob rather than `ls` so odd filenames are handled safely.
first_moon_id() {
    local f
    shopt -s nullglob
    for f in "$DATA_DIR"/zerotier-one/moons.d/*.moon; do
        basename "$f" .moon
        shopt -u nullglob
        return 0
    done
    shopt -u nullglob
    return 1
}

# Print the 10-char world ID used by `zerotier-cli orbit` (NOT the 16-char
# padded filename, which orbit rejects). Prefers the live daemon's own address;
# falls back to the last 10 hex chars of the .moon filename.
moon_world_id() {
    local addr padded
    addr="$(zt info 2>/dev/null | awk '{print $3}')"
    if [[ "$addr" =~ ^[0-9a-f]{10}$ ]]; then
        echo "$addr"; return 0
    fi
    padded="$(first_moon_id || true)"
    [[ -n "$padded" ]] || return 1
    echo "${padded: -10}"
}

# ─── help / version ──────────────────────────────────────────────────────────
cmd_help() {
    sed -n '3,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

cmd_version() {
    say "${BOLD}zmoon${NC} v${ZMOON_VERSION}"
    if command -v docker >/dev/null 2>&1 && container_running; then
        local ztv
        ztv="$(docker exec "$CONTAINER_NAME" zerotier-one --version 2>/dev/null || echo 'unknown')"
        say "ZeroTier: ${ztv}"
    fi
}

# ─── install / update (delegate) ─────────────────────────────────────────────
cmd_install() { exec bash "$SCRIPT_DIR/install.sh" "$@"; }
cmd_update()  { exec bash "$SCRIPT_DIR/update.sh"  "$@"; }

# ─── status ──────────────────────────────────────────────────────────────────
cmd_status() {
    load_env; need_docker
    hdr "ZeroTier Moon — Status"

    local cstate
    cstate="$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || echo 'not found')"
    if container_running; then
        ok "Container : ${G}${cstate}${NC}"
    else
        warn "Container : ${Y}${cstate}${NC}"
    fi

    local health
    health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$CONTAINER_NAME" 2>/dev/null || echo 'unknown')"
    say "  Health    : ${health}"

    local ztstatus
    ztstatus="$(zt status || echo 'unreachable')"
    say "  ZeroTier  : ${ztstatus}"

    local moon_id
    moon_id="$(first_moon_id || true)"
    say "  Moon ID   : ${moon_id:-none}"

    local peer_count
    peer_count="$(zt -j listpeers 2>/dev/null | grep -c '"address"' || echo 0)"
    say "  Peers     : ${peer_count}"
}

# ─── peers (parsed) ──────────────────────────────────────────────────────────
cmd_peers() {
    load_env; need_docker
    container_running || die "container not running"
    hdr "ZeroTier Peers"
    printf "  ${DIM}%-12s %-8s %-9s %-7s %s${NC}\n" "ADDRESS" "ROLE" "LATENCY" "VER" "PATH"

    local json
    json="$(zt -j listpeers || echo '[]')"
    if command -v jq >/dev/null 2>&1; then
        echo "$json" | jq -r '.[] |
            [ .address,
              .role,
              (if .latency >= 0 then (.latency|tostring)+"ms" else "n/a" end),
              (.version // "-"),
              (if (.paths | map(select(.active)) | length) > 0
                 then (.paths[] | select(.active) | .address) else "RELAYED" end)
            ] | @tsv' 2>/dev/null \
        | while IFS=$'\t' read -r addr role lat ver path; do
            printf "  %-12s %-8s %-9s %-7s %s\n" "$addr" "$role" "$lat" "$ver" "$path"
          done
    else
        # jq missing — run it inside the container, which always has jq
        docker exec "$CONTAINER_NAME" sh -c \
          'zerotier-cli -j listpeers | jq -r ".[] | [.address,.role,((.latency|tostring)+\"ms\"),(.version//\"-\")] | @tsv"' \
          2>/dev/null \
        | while IFS=$'\t' read -r addr role lat ver; do
            printf "  %-12s %-8s %-9s %-7s\n" "$addr" "$role" "$lat" "$ver"
          done
    fi
}

# ─── moon-id ─────────────────────────────────────────────────────────────────
cmd_moon_id() {
    load_env
    local moon_id
    moon_id="$(moon_world_id || true)"
    [[ -n "$moon_id" ]] || die "no .moon file found — moon not yet generated"
    say "${BOLD}Moon ID:${NC} ${moon_id}"
    say ""
    say "On every client that should use this moon, run:"
    say "  ${G}zerotier-cli orbit ${moon_id} ${moon_id}${NC}"
}

# ─── connect — full, populated join instructions for THIS moon ───────────────
cmd_connect() {
    load_env
    local moon_id net_id padded
    moon_id="$(moon_world_id || true)"
    [[ -n "$moon_id" ]] || die "no .moon file found — start the container so the moon generates its identity first"
    net_id="${ZT_NETWORK_ID:-}"
    padded="$(first_moon_id || true)"

    hdr "Connect a device to this moon"
    say ""
    say "${BOLD}Linux / macOS${NC} — run on the client:"
    say "  ${G}curl -s https://install.zerotier.com | sudo bash${NC}"
    if [[ -n "$net_id" ]]; then
        say "  ${G}sudo zerotier-cli join ${net_id}${NC}"
    else
        say "  ${G}sudo zerotier-cli join <network-id>${NC}   ${DIM}# ZT_NETWORK_ID not set in .env${NC}"
    fi
    say "  ${G}sudo zerotier-cli orbit ${moon_id} ${moon_id}${NC}"
    say "  ${G}sudo zerotier-cli listpeers | grep ${moon_id}${NC}   ${DIM}# expect a MOON line with a real latency${NC}"
    say ""
    say "${BOLD}Windows${NC}:"
    say "  1. Install ZeroTier One (MSI from zerotier.com); join ${net_id:-<network-id>} from the tray app."
    # No trailing backslash before ${NC}: echo -e would eat it into the escape
    # sequence and print a literal \033[0m instead of resetting the colour.
    say "  2. Copy this file into ${BOLD}C:\\ProgramData\\ZeroTier\\One\\moons.d${NC} :"
    say "     ${DIM}${DATA_DIR}/zerotier-one/moons.d/${padded}.moon${NC}"
    say "  3. Restart the ZeroTier One service."
    if [[ -n "$net_id" ]]; then
        say ""
        say "This moon runs its own controller — after the client joins, ${BOLD}authorize${NC} it"
        say "in the web console (${G}zmoon web${NC} → Members → toggle Authorized)."
    fi
}

# ─── backup / restore ────────────────────────────────────────────────────────
cmd_backup() {
    load_env
    local zt_home="$DATA_DIR/zerotier-one"
    [[ -f "$zt_home/identity.secret" ]] || die "identity.secret missing — nothing to back up"

    local dest
    dest="$DATA_DIR/backups/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$dest"
    cp "$zt_home/identity.secret" "$zt_home/identity.public" "$dest/"
    [[ -f "$zt_home/moon.json" ]] && cp "$zt_home/moon.json" "$dest/"
    ok "Backed up moon identity to $dest"

    local count
    count="$(find "$DATA_DIR/backups" -maxdepth 1 -name '[0-9]*' -type d 2>/dev/null | wc -l)"
    if [[ "$count" -gt 5 ]]; then
        find "$DATA_DIR/backups" -maxdepth 1 -name '[0-9]*' -type d 2>/dev/null \
            | sort | head -n $(( count - 5 )) | xargs -r rm -rf
        ok "Pruned old backups (kept 5 most recent)"
    fi
}

cmd_restore() {
    load_env; need_docker
    local src="${1:-}"
    [[ -n "$src" ]] || die "usage: zmoon restore <backup-dir>"
    [[ -d "$src" ]] || die "backup dir not found: $src"
    [[ -f "$src/identity.secret" ]] || die "no identity.secret in $src"

    local zt_home="$DATA_DIR/zerotier-one"
    warn "This overwrites the live moon identity. The moon's address WILL change"
    warn "unless this backup matches the current identity."
    printf "  Type 'restore' to continue: "
    local confirm; read -r confirm
    [[ "$confirm" == "restore" ]] || die "aborted"

    if container_running; then
        docker stop "$CONTAINER_NAME" >/dev/null
        ok "Stopped container"
    fi
    cp "$src/identity.secret" "$src/identity.public" "$zt_home/"
    [[ -f "$src/moon.json" ]] && cp "$src/moon.json" "$zt_home/"
    ok "Restored identity from $src"
    docker start "$CONTAINER_NAME" >/dev/null
    ok "Restarted container — verify with 'zmoon status'"
}

# ─── logs ────────────────────────────────────────────────────────────────────
cmd_logs() {
    load_env; need_docker
    if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
        exec docker logs -f --tail 100 "$CONTAINER_NAME"
    fi
    docker logs --tail 100 "$CONTAINER_NAME"
}

# ─── doctor ──────────────────────────────────────────────────────────────────
# Automated health checks distilled from .github/STABILITY.md. Each check
# prints PASS/WARN/FAIL; the command exits non-zero if any FAIL occurred so
# it can be wired into monitoring / cron.
DR_FAIL=0
DR_WARN=0
chk_pass() { echo -e "  ${G}PASS${NC}  $*"; }
chk_warn() { echo -e "  ${Y}WARN${NC}  $*"; DR_WARN=$(( DR_WARN + 1 )); }
chk_fail() { echo -e "  ${R}FAIL${NC}  $*"; DR_FAIL=$(( DR_FAIL + 1 )); }

cmd_doctor() {
    load_env; need_docker
    hdr "ZeroTier Moon — Diagnostics"

    # 1. Container running
    if container_running; then
        chk_pass "Container is running"
    else
        chk_fail "Container is not running (start: zmoon update --no-build)"
        say "\n${R}Container down — remaining checks skipped.${NC}"
        exit 1
    fi

    # 2. Healthcheck status
    local health
    health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$CONTAINER_NAME" 2>/dev/null)"
    case "$health" in
        healthy)   chk_pass "Docker healthcheck: healthy" ;;
        none)      chk_warn "No Docker healthcheck configured" ;;
        starting)  chk_warn "Healthcheck still starting" ;;
        *)         chk_fail "Docker healthcheck: $health" ;;
    esac

    # 3. ZeroTier daemon responsive
    if zt status | grep -q ONLINE; then
        chk_pass "ZeroTier daemon ONLINE"
    else
        chk_fail "ZeroTier daemon not ONLINE"
    fi

    # 4. NET_RAW capability (required for NOTRACK)
    if docker exec "$CONTAINER_NAME" grep -q CapEff /proc/1/status 2>/dev/null; then
        chk_pass "Capability set present (CapEff readable)"
    else
        chk_warn "Could not read process capabilities"
    fi

    # 5. NOTRACK applied for UDP 9993. When the kernel has no raw table at all
    # (DSM often omits iptable_raw), NOTRACK is impossible rather than
    # misconfigured — downgrade to WARN if the host conntrack timeout (the
    # thing NOTRACK protects against) is already raised.
    if docker exec "$CONTAINER_NAME" iptables -t raw -S 2>/dev/null | grep -q 'NOTRACK'; then
        chk_pass "NOTRACK rule active for ZeroTier UDP"
    elif ! docker exec "$CONTAINER_NAME" iptables -t raw -L -n >/dev/null 2>&1; then
        local _ct
        _ct="$(sysctl -n net.netfilter.nf_conntrack_udp_timeout 2>/dev/null || echo 0)"
        if [[ "$_ct" -ge 120 ]]; then
            chk_warn "raw table unavailable in kernel — NOTRACK impossible; host conntrack ${_ct}s covers keepalives"
        else
            chk_fail "raw table unavailable AND host conntrack timeout ${_ct}s — run 'zmoon boot'"
        fi
    else
        chk_fail "NOTRACK missing — conntrack 30s timeout may cut connections"
    fi

    # 6. FORWARD ACCEPT rules for zt+ <-> NIC (macvlan injects none)
    if docker exec "$CONTAINER_NAME" iptables -S FORWARD 2>/dev/null | grep -q 'zt+'; then
        chk_pass "FORWARD rules present for ZeroTier overlay"
    else
        chk_warn "No zt+ FORWARD rules — relay/gateway traffic may be dropped"
    fi

    # 7. Socket buffers tuned — read on the HOST. DSM does not expose
    # net.core.* inside the container namespace, so the old in-container read
    # returned 0 forever and warned even when the host was tuned correctly.
    local rmem
    rmem="$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)"
    if [[ "$rmem" -ge 8388608 ]]; then
        chk_pass "UDP socket buffers tuned (host rmem_max=${rmem})"
    else
        chk_warn "host rmem_max=${rmem} (expected >= 8388608) — run 'zmoon boot'"
    fi

    # 8. fq qdisc on the ZT interface
    local zt_if
    zt_if="$(docker exec "$CONTAINER_NAME" sh -c "ip -o link show | awk -F': ' '/ zt/{print \$2; exit}'" 2>/dev/null | tr -d ' ')"
    if [[ -n "$zt_if" ]]; then
        local qd
        qd="$(docker exec "$CONTAINER_NAME" tc qdisc show dev "$zt_if" 2>/dev/null | awk '/^qdisc/{print $2; exit}')"
        case "$qd" in
            fq)              chk_pass "fq qdisc active on $zt_if" ;;
            fq_codel|codel)  chk_pass "$qd qdisc active on $zt_if (sch_fq unavailable — good fallback)" ;;
            sfq)             chk_pass "sfq qdisc active on $zt_if (fq/fq_codel unavailable — per-flow fairness fallback)" ;;
            *)               chk_warn "no anti-bufferbloat qdisc on $zt_if (got '${qd:-none}'; kernel lacks fq/fq_codel/sfq)" ;;
        esac
    else
        chk_warn "No ZeroTier interface yet (not joined a network?)"
    fi

    # 9. Policy routing rules present and not duplicated
    local rule_count
    rule_count="$(docker exec "$CONTAINER_NAME" ip rule show 2>/dev/null | grep -cE 'lookup (ISP_1|ISP_2)' || echo 0)"
    if [[ "$rule_count" -eq 4 ]]; then
        chk_pass "Policy routing rules correct (4 ISP_1/ISP_2 rules)"
    elif [[ "$rule_count" -eq 0 ]]; then
        chk_warn "No ISP_1/ISP_2 policy rules — single-NIC or setuproutes failed"
    elif [[ "$rule_count" -gt 4 ]]; then
        chk_fail "Duplicate policy rules ($rule_count) — flush bug; restart container"
    else
        chk_warn "Partial policy rules ($rule_count/4)"
    fi

    # 10. conntrack UDP timeout raised on host (best-effort, host ns)
    if command -v sysctl >/dev/null 2>&1; then
        local cto
        cto="$(sysctl -n net.netfilter.nf_conntrack_udp_timeout 2>/dev/null || echo '')"
        if [[ -n "$cto" && "$cto" -ge 120 ]]; then
            chk_pass "Host conntrack UDP timeout = ${cto}s"
        elif [[ -n "$cto" ]]; then
            chk_warn "Host conntrack UDP timeout = ${cto}s (expected >= 120; re-run install.sh)"
        else
            chk_warn "Cannot read host conntrack timeout (not on NAS host?)"
        fi
    fi

    # 11. Peer path quality (relayed peers = degraded)
    if command -v jq >/dev/null 2>&1; then
        local relayed
        relayed="$(zt -j listpeers 2>/dev/null \
            | jq '[.[] | select(.role=="LEAF") | select((.paths|map(select(.active))|length)==0)] | length' 2>/dev/null || echo 0)"
        if [[ "${relayed:-0}" -eq 0 ]]; then
            chk_pass "All leaf peers have a direct path"
        else
            chk_warn "$relayed leaf peer(s) relayed — check router UDP 9993 forward"
        fi
    fi

    # 12. IPv6 forwarding enabled on host
    if command -v sysctl >/dev/null 2>&1; then
        local ipv6fwd
        ipv6fwd="$(sysctl -n net.ipv6.conf.all.forwarding 2>/dev/null || echo '')"
        if [[ "$ipv6fwd" == "1" ]]; then
            chk_pass "Host IPv6 forwarding enabled (net.ipv6.conf.all.forwarding=1)"
        else
            chk_fail "Host IPv6 forwarding disabled — run: sysctl -w net.ipv6.conf.all.forwarding=1"
        fi
    fi

    # 13. ip6tables FORWARD rules loaded in container
    if docker exec "$CONTAINER_NAME" ip6tables -L FORWARD -n 2>/dev/null | grep -q ACCEPT; then
        chk_pass "ip6tables FORWARD rules present in container"
    else
        chk_warn "No ip6tables FORWARD ACCEPT rules — apply ip6tables rules: ip6tables-restore < /etc/iptables/rules.v6"
    fi

    # ─── Summary ─────────────────────────────────────────────────────────────
    hdr "Summary"
    if [[ "$DR_FAIL" -gt 0 ]]; then
        err "${DR_FAIL} failed, ${DR_WARN} warning(s) — action required"
        exit 1
    elif [[ "$DR_WARN" -gt 0 ]]; then
        warn "${DR_WARN} warning(s), 0 failures — review above"
        exit 0
    else
        ok "All checks passed — moon is healthy"
        exit 0
    fi
}

# ─── autoupdate ──────────────────────────────────────────────────────────────
cmd_autoupdate() {
    load_env
    local enabled="${AUTO_UPDATE:-false}"
    local branch="${AUTO_UPDATE_BRANCH:-dev}"
    local log_file="$DATA_DIR/autoupdate.log"

    mkdir -p "$DATA_DIR"
    # Rotate log at 1 MB
    if [[ -f "$log_file" ]] && [[ $(stat -c%s "$log_file" 2>/dev/null || echo 0) -gt 1048576 ]]; then
        mv "$log_file" "${log_file}.1"
    fi

    _aulog() { echo "$(date '+%Y-%m-%d %H:%M:%S') [autoupdate] $*" | tee -a "$log_file"; }

    if [[ "$enabled" != "true" ]]; then
        _aulog "disabled (AUTO_UPDATE=false in .env) — skipping"
        exit 0
    fi

    if ! command -v git &>/dev/null; then
        _aulog "ERROR: git not found — install via DSM Package Center"
        exit 1
    fi
    if ! git -C "$SCRIPT_DIR" rev-parse --git-dir &>/dev/null; then
        _aulog "ERROR: not a git repo — clone the repo first"
        exit 1
    fi

    _aulog "Checking $branch for updates..."
    if ! git -C "$SCRIPT_DIR" fetch origin "$branch" --quiet 2>/dev/null; then
        _aulog "WARNING: git fetch failed (network?) — skipping"
        exit 0
    fi

    local local_sha remote_sha
    local_sha=$(git -C "$SCRIPT_DIR" rev-parse HEAD)
    remote_sha=$(git -C "$SCRIPT_DIR" rev-parse "origin/$branch")

    if [[ "$local_sha" == "$remote_sha" ]]; then
        _aulog "Up to date ($branch @ ${local_sha:0:7}) — nothing to do"
        exit 0
    fi

    _aulog "Update available: ${local_sha:0:7} → ${remote_sha:0:7} on $branch"
    _aulog "Running: zmoon update --branch $branch"
    bash "$SCRIPT_DIR/update.sh" --branch "$branch" 2>&1 | tee -a "$log_file"
    _aulog "Update complete"
}

# ─── boot — re-apply host tuning after a reboot ──────────────────────────────
# DSM does not reliably re-read /etc/sysctl.conf on boot and NIC offload always
# resets, so the host-level speed/stability tuning must be re-applied. Wire this
# to a DSM Task Scheduler "Boot-up" trigger (user: root). Container itself is
# restart:always, so this only ensures the HOST is retuned and the container up.
cmd_boot() {
    load_env
    # shellcheck source=lib/tuning.sh
    source "$SCRIPT_DIR/lib/tuning.sh"
    local log_file="$DATA_DIR/boot.log"
    mkdir -p "$DATA_DIR"
    # Rotate at 1 MB so a frequent cron schedule can't grow the log unbounded
    if [[ -f "$log_file" ]] && [[ $(stat -c%s "$log_file" 2>/dev/null || echo 0) -gt 1048576 ]]; then
        mv "$log_file" "${log_file}.1"
    fi
    _blog() { echo "$(date '+%Y-%m-%d %H:%M:%S') [boot] $*" | tee -a "$log_file"; }

    local if1 if2
    if1="$(iface_for "$LAN1_SUBNET")"
    if2="$(iface_for "$LAN2_SUBNET")"
    apply_host_tuning "$if1" "$if2"
    _blog "host tuning re-applied (socket buffers + conntrack 300s + offload on ${if1:-?}/${if2:-?})"

    if command -v docker >/dev/null 2>&1; then
        if container_running; then
            _blog "container ${CONTAINER_NAME} already running"
            # ── Watchdog: heal a running-but-offline moon ────────────────────
            # Docker NEVER restarts an unhealthy container on its own — the
            # healthcheck only labels it. A wedged daemon (process alive, moon
            # offline) would otherwise sit dead until someone noticed. Since
            # this command runs from the 15-min cron, restart when the daemon
            # doesn't answer ONLINE — EXCEPT a deliberately held container
            # (entrypoint hold(): misconfigured install awaiting a fix), where
            # a restart would just re-enter the same hold.
            if ! zt status 2>/dev/null | grep -q ONLINE; then
                if docker logs --tail 5 "$CONTAINER_NAME" 2>&1 | grep -q "held for inspection"; then
                    _blog "container is HELD (unconfigured/fatal state) — not restarting; see docker logs ${CONTAINER_NAME}"
                elif docker restart --time=15 "$CONTAINER_NAME" >/dev/null 2>&1; then
                    _blog "WATCHDOG: daemon not ONLINE — container restarted"
                else
                    _blog "WATCHDOG: daemon not ONLINE and restart failed"
                fi
            fi
        elif docker start "$CONTAINER_NAME" >/dev/null 2>&1; then
            _blog "started container ${CONTAINER_NAME}"
        else
            _blog "WARNING: could not start ${CONTAINER_NAME}"
        fi
    fi
    _blog "boot tasks complete"
}

# ─── install-cron / uninstall-cron — persist tuning via DSM's cron ───────────
# DSM /etc/crontab format is TAB-separated: m<TAB>h<TAB>dom<TAB>mon<TAB>dow<TAB>user<TAB>command.
# Spaces between columns make DSM silently drop the line, so we build with tabs.
CRON_TAG="# zmoon-boot (host tuning re-apply — do not edit this block by hand)"

# Reload cron across DSM generations: DSM 7 uses synosystemctl, DSM 6 uses
# synoservice; plain systemctl is the non-DSM fallback. Order matters — try the
# DSM-native ones first since a stock systemctl may exist but not manage crond.
_reload_crond() {
    synosystemctl restart crond 2>/dev/null && return 0
    synoservice --restart crond 2>/dev/null && return 0
    synoservicectl --restart crond 2>/dev/null && return 0
    systemctl restart crond 2>/dev/null && return 0
    return 1
}

cmd_install_cron() {
    [[ "$(id -u)" -eq 0 ]] || die "run as root (sudo -i) — editing /etc/crontab needs root"
    # No load_env: nothing here needs .env, and staying independent of it lets
    # install.sh call this before the first config is even written.
    local schedule="${1:-*/15 * * * *}" crontab="${ZMOON_CRONTAB:-/etc/crontab}" self
    self="$(command -v zmoon 2>/dev/null || echo "$SCRIPT_DIR/zmoon")"
    [[ -f "$crontab" ]] || die "$crontab not found — is this a DSM host?"

    if grep -qF "$CRON_TAG" "$crontab"; then
        ok "cron entry already present in $crontab — nothing to do"
    else
        local m h dom mon dow line
        read -r m h dom mon dow <<< "$schedule"
        [[ -n "$dow" ]] || die "schedule must be 5 fields, e.g. '*/15 * * * *'"
        line="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$m" "$h" "$dom" "$mon" "$dow" root "$self boot")"
        printf '%s\n%s\n' "$CRON_TAG" "$line" >> "$crontab"
        ok "Added to $crontab: '$schedule' → $self boot (root)"
    fi
    if _reload_crond; then ok "crond reloaded"; else warn "reload crond manually or reboot to activate"; fi
    say ""
    say "Event-driven alternative (runs once, only on boot — no periodic overhead):"
    say "  DSM Task Scheduler → Triggered Task → ${BOLD}Boot-up${NC} (user root)"
    say "  Run command: ${G}${self} boot${NC}   ${DIM}# absolute path — scheduler PATH is minimal${NC}"
}

cmd_uninstall_cron() {
    [[ "$(id -u)" -eq 0 ]] || die "run as root (sudo -i)"
    local crontab="${ZMOON_CRONTAB:-/etc/crontab}" tmp
    grep -qF "$CRON_TAG" "$crontab" 2>/dev/null || { ok "no zmoon cron entry present"; return 0; }
    tmp="$(mktemp)"
    grep -vF "$CRON_TAG" "$crontab" | grep -v 'zmoon boot' > "$tmp" && cat "$tmp" > "$crontab"
    rm -f "$tmp"
    _reload_crond >/dev/null 2>&1 || true
    ok "Removed zmoon cron entry from $crontab"
}

# ─── web console ─────────────────────────────────────────────────────────────
cmd_web() {
    load_env
    command -v python3 >/dev/null 2>&1 || die "python3 not found (install via DSM Package Center)"
    local host="0.0.0.0" port="8088"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host) host="$2"; shift 2 ;;
            --port) port="$2"; shift 2 ;;
            *) die "usage: zmoon web [--host H] [--port P]" ;;
        esac
    done
    if [[ -z "${WEB_ADMIN_PASSWORD:-}" ]]; then
        warn "WEB_ADMIN_PASSWORD not set in .env — console is READ-ONLY (Update/Restart disabled)"
        warn "Set it in .env to enable the Update button; expose only on a trusted LAN."
    fi
    say "Starting web console on ${BOLD}http://${host}:${port}${NC} (Ctrl-C to stop)"
    exec python3 "$SCRIPT_DIR/web/server.py" --host "$host" --port "$port"
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-help}"
    if [[ $# -gt 0 ]]; then shift; fi
    case "$cmd" in
        install)            cmd_install "$@" ;;
        update)             cmd_update "$@" ;;
        status|st)          cmd_status "$@" ;;
        doctor|diagnose)    cmd_doctor "$@" ;;
        peers)              cmd_peers "$@" ;;
        moon-id|moonid)     cmd_moon_id "$@" ;;
        connect)            cmd_connect "$@" ;;
        backup)             cmd_backup "$@" ;;
        restore)            cmd_restore "$@" ;;
        logs)               cmd_logs "$@" ;;
        web)                cmd_web "$@" ;;
        boot)               cmd_boot "$@" ;;
        install-cron)       cmd_install_cron "$@" ;;
        uninstall-cron)     cmd_uninstall_cron "$@" ;;
        autoupdate)         cmd_autoupdate "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h)     cmd_help ;;
        *)                  err "unknown command: $cmd"; echo; cmd_help; exit 64 ;;
    esac
}

main "$@"
